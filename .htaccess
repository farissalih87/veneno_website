# ==========================================================
# Veneno Auto Care - Root .htaccess for cPanel Shared Hosting
# ==========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct access to sensitive system files
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^composer\.(json|lock)$ - [F,L,NC]
    RewriteRule ^package(-lock)?\.json$ - [F,L,NC]
    RewriteRule ^(artisan|vite\.config\.js|\.git.*)$ - [F,L,NC]

    # 2. Block direct web access to internal application directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|scripts)($|/) - [F,L,NC]

    # 3. Route all traffic to public/ folder cleanly without loops
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

