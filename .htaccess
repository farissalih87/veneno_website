# ==========================================================
# Veneno Auto Care - Root .htaccess for cPanel Shared Hosting
# ==========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Block direct access to sensitive system files (.env, composer, git, artisan, etc.)
    RewriteRule ^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|\.git.*|artisan|phpunit\.xml|vite\.config\.js|\.sql)$ - [F,L,NC]

    # 2. Block direct web access to internal application directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|scripts)($|/) - [F,L,NC]

    # 3. Route all valid web traffic to the public/ folder (negative lookahead prevents rewrite loops)
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

# Disable Directory Browsing safely
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

