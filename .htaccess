# ==========================================================
# Veneno Auto Care - Root .htaccess for cPanel Shared Hosting
# ==========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS (Optional on cPanel SSL)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Block direct access to sensitive system files
    <FilesMatch "(^\.env|composer\.(json|lock)|package(-lock)?\.json|\.git|\.editorconfig|artisan|phpunit\.xml|vite\.config\.js|\.sql)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order deny,allow
            Deny from all
        </IfModule>
    </FilesMatch>

    # 3. Block direct web access to internal application directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|scripts)/ - [F,L,NC]

    # 4. Route all valid web traffic to the public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable Directory Browsing
Options -Indexes
