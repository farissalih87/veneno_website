# ==============================================================================
# Veneno Auto Care - Professional Git Ignore Rules
# ==============================================================================

# --- Environment & Credentials ---
.env
.env.backup
.env.production
.env.*.local
auth.json

# --- Dependency Directories ---
node_modules/
vendor/

# --- Storage & Framework Runtime Caches ---
storage/*.key
storage/pail
storage/logs/*
!storage/logs/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
bootstrap/cache/*
!bootstrap/cache/.gitignore
*.log

# --- Public Assets & Media (Uploaded separately to keep repository lightweight) ---
public/hot
public/storage
public/images/
public/videos/

# --- Large Archives & Media Dumps ---
*.zip
*.tar
*.gz
*.rar
*.7z
*.mov
Venono_Car_media*
Venono_Car_media/
veneno-ae-cpanel-*
veneno_autocare_db*

# --- Local Scripts & Test Utilities ---
scripts/
askpass.bat
test_*.php
test_*.py
check_*.php
check_*.py

# --- IDEs & Operating System Files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.fleet/
.idea/
.nova/
.phpunit.cache/
.phpunit.result.cache
.vscode/
.zed/
.phpactor.json
Homestead.json
Homestead.yaml